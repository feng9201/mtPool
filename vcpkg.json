{
    "name": "mtpool",
    "version": "1.0.0",
    "description": "Process-wide C++17 thread pool with optional delayed tasks",
    "homepage": "https://github.com/feng9201/mtPool",
    "license": "MIT",
    "dependencies": [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        }
    ],
    "default-features": [],
    "features": {
        "shared": {
            "description": "Build as shared library (DLL/.so/.dylib). Without this feature, linkage follows the triplet."
        },
        "delayed": {
            "description": "Enable wall-clock delayed tasks (PostDelayedTask / SequenceToken)"
        }
    }
}
